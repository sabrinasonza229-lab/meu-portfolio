# Copie este arquivo para .env.local e preencha com os dados do seu projeto Firebase.
# (Console do Firebase > Configurações do projeto > Seus apps > firebaseConfig)
# O .env.local NÃO vai para o GitHub. Este arquivo de exemplo, sim.
#
# Estes valores do Firebase não são segredo: só dizem qual projeto usar.
# Quem protege os dados são as regras (arquivo firestore.rules).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Seu usuário do GitHub (alimenta a página /github). Opcional.
GITHUB_USER=
